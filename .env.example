# AWS Bedrock credentials
AWS_REGION=us-east-2
AWS_ACCESS_KEY_ID=your_access_key_here
AWS_SECRET_ACCESS_KEY=your_secret_key_here

# Path to TIQ World codebase on your machine
TIQ_CODEBASE_PATH=C:/Users/Shalini Mishra/TIQ

# PostgreSQL connection for db_query tool
# Requires SSM tunnel running: ssh -L 5433:rds-host:5432 bastion
# Format: postgresql://user:password@localhost:5433/dbname
DB_URL=postgresql://postgres:password@localhost:5433/tiqworld

# Web UI port (default: 3001) — run with: npm run web
WEB_PORT=3001

# Bedrock prompt caching — reduces token cost ~60% on long sessions
# Set to true to enable (requires Bedrock prompt caching support in your region)
ENABLE_PROMPT_CACHE=false

# Legacy interval scan (0 = disabled — use cron schedules below instead)
SCAN_INTERVAL_MINUTES=0

# ─── Semi-autonomous maintenance ─────────────────────────────────────────────
# Cron syntax (runs in IST timezone)
# "0 2 * * *"   = 2:00 AM every night
# "0 */2 * * *" = every 2 hours
NIGHT_MAINTENANCE_CRON="0 2 * * *"
DAY_LIGHT_SCAN_CRON="0 */2 * * *"

# Auto-fix: agent autonomously fixes safe issues (lint errors, null checks, cleanup)
# Set to false to make maintenance scan-and-report only — no automatic writes
AUTO_FIX_ENABLED=true

# Minimum confidence score (0-100) from fix_error before an auto-fix is attempted
# Below this threshold the issue is flagged in the report but not auto-fixed
AUTO_FIX_MIN_CONFIDENCE=55

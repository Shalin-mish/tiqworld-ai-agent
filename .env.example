# AWS Bedrock
AWS_REGION=us-east-2
AWS_ACCESS_KEY_ID=your_access_key
AWS_SECRET_ACCESS_KEY=your_secret_key

# Target codebase path — point this at any project directory, any language, any size
# If not set, defaults to current working directory (process.cwd())
CODEBASE_PATH=C:/path/to/your/project

# Legacy alias (still works for backward compatibility)
# TIQ_CODEBASE_PATH=C:/Users/Shalini Mishra/TIQ

# PostgreSQL via SSM tunnel
DB_URL=postgresql://user:password@localhost:5433/tiqworld

# Web server port
WEB_PORT=3001

# Bedrock prompt caching (saves ~90% on input tokens on repeat queries — always keep true)
ENABLE_PROMPT_CACHE=true

# Per-call Bedrock timeout in ms. 3 retries × this = max wait before error.
# Default: 180000 (3 min). Raise for large codebases, lower for faster failures.
BEDROCK_TIMEOUT_MS=180000

# Overall chat request timeout in ms — SSE connection is killed after this.
# Should be > BEDROCK_TIMEOUT_MS × retries. Default: 600000 (10 min).
CHAT_TIMEOUT_MS=600000

# Auto maintenance scan interval in minutes (0 = run once at startup only)
SCAN_INTERVAL_MINUTES=0

# Maintenance schedule (cron syntax, Asia/Kolkata timezone)
NIGHT_MAINTENANCE_CRON=0 2 * * *
# Day light scan runs once per day at 9 AM IST (just healthCheck + monitor — no heavy lint/todos)
DAY_LIGHT_SCAN_CRON=0 9 * * *

# Max wall-clock time for a single night maintenance run. If the agent hangs, it is
# forcibly aborted after this duration. Default: 2 hours. Unit: milliseconds.
MAINTENANCE_TIMEOUT_MS=7200000

# Auto-fix: agent fixes safe issues without human approval during night maintenance
# Set to false to make maintenance scan-only (no writes)
AUTO_FIX_ENABLED=true
# Minimum confidence for auto-fix (0-100). 80 = only high-confidence fixes.
# Lower this only if you trust the agent fully — 55 is too risky for production.
AUTO_FIX_MIN_CONFIDENCE=80

# Notifications: Slack or Discord webhook URL
# Slack:   https://hooks.slack.com/services/...
# Discord: https://discord.com/api/webhooks/...
# Leave blank to use in-app notifications only
NOTIFICATION_WEBHOOK_URL=

# Health Monitor: comma-separated list of URLs to probe every day scan cycle
# Agent will HTTP GET each URL and alert if any returns non-2xx or responds slowly (>3s)
# Example: https://yourapp.com/api/health,https://yourapp.com/login
# Default (if blank): http://localhost:3001/api/status
HEALTH_MONITOR_URLS=

# GitHub OAuth — sign in with real GitHub accounts instead of free-text names
# 1. Go to github.com/settings/developers → New OAuth App
# 2. Homepage URL: http://localhost:3001
# 3. Callback URL: http://localhost:3001/auth/github/callback
# 4. Copy Client ID + Client Secret below
# Leave blank to use name-only mode (no OAuth)
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
SESSION_SECRET=change-me-to-a-random-string
